APP_NAME=Stocker API
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=stocker

DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/stocker

JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gmail SMTP (앱 비밀번호 사용 권장)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_NAME=Stock+er
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your-email@gmail.com

EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_SIGNUP_TOKEN_EXPIRE_MINUTES=10

# Google OAuth2 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Kakao OAuth2 (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
FRONTEND_KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback

# Naver OAuth2 (https://developers.naver.com)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/naver/callback
FRONTEND_NAVER_CALLBACK_URL=http://localhost:3000/auth/naver/callback

# Toss Payments (https://developers.tosspayments.com)
TOSS_SECRET_KEY=your_toss_secret_key

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_PRODUCT_FOLDER=stocker/products
CLOUDINARY_DETAIL_FOLDER=stocker/product-details

# Naver 검색광고 API (https://api.naver.com)
API_KEY=your_naver_searchad_api_key
API_SECRET=your_naver_searchad_api_secret
CUSTOMER_ID=your_naver_searchad_customer_id

# Naver Shopping Insight API
CLIENT_ID=your_naver_client_id
CLIENT_SECRET=your_naver_client_secret
